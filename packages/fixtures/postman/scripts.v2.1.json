{
  "info": {
    "_postman_id": "scripts",
    "name": "Scripts",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.environment.set('t', Date.now());"
        ]
      }
    }
  ],
  "item": [
    {
      "id": "tested",
      "name": "Tested",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "s1",
            "type": "text/javascript",
            "exec": [
              "pm.test('ok', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/echo"
      }
    },
    {
      "id": "folder-scripts",
      "name": "With folder script",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              ""
            ]
          }
        }
      ],
      "item": []
    }
  ]
}
