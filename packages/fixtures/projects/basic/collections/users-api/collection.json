{
  "info": {
    "_postman_id": "users-collection",
    "name": "Users API",
    "description": "User operations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "x-info": "preserved"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('users');"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.example.test",
      "type": "string"
    }
  ],
  "x-collection": 1,
  "_pigeon": {
    "order": [
      "list-users",
      "admin",
      "create-user"
    ],
    "x-pigeon": "kept"
  }
}
