{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2022"],
    "types": ["node"],
    // Sources run directly under Node's type stripping (`pnpm start`), which needs real
    // `.ts` import specifiers and erasable-only syntax.
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src"]
}
