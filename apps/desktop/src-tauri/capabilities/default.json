{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core defaults for the main window only. Each later story adds just the permissions it needs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-http-send",
    "allow-http-cancel",
    "allow-save-file",
    "allow-smoke-report",
    "allow-project-pick-folder",
    "allow-project-create",
    "allow-project-reopen",
    "allow-project-fs-read",
    "allow-project-fs-write",
    "allow-project-fs-stat",
    "allow-project-fs-list",
    "allow-project-fs-mkdirp",
    "allow-project-fs-remove",
    "allow-project-fs-rename",
    "allow-project-watch",
    "allow-project-unwatch",
    "allow-app-state-read",
    "allow-app-state-write",
    "allow-app-state-backup",
    "allow-secrets-read",
    "allow-secrets-write",
    "allow-secrets-remove",
    "allow-keychain-status",
    "allow-keychain-get-all",
    "allow-keychain-set",
    "allow-keychain-delete",
    "allow-keychain-clear",
    "allow-oauth-begin",
    "allow-oauth-complete",
    "allow-history-append",
    "allow-history-list",
    "allow-history-get",
    "allow-history-remove",
    "allow-history-clear"
  ]
}
